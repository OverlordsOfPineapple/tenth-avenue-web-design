:root {
  font-family:
    Inter, Arial, Helvetica, sans-serif;
  color: #ffffff;
  background: #000000;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: #000000;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  overflow-x: hidden;
  background:
    radial-gradient(
      circle at 75% 25%,
      rgba(255, 0, 126, 0.14),
      transparent 35%
    ),
    #000000;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  color: inherit;
}

.prototype-page {
  min-height: 100vh;
  background: #000000;
}

.website-canvas {
  position: relative;
  width: 100%;
  max-width: 1920px;
  margin: 0 auto;
  overflow: hidden;
  background: #000000;
}

.website-image {
  display: block;
  width: 100%;
  height: auto;
  user-select: none;
  pointer-events: none;
}

.hotspot {
  position: absolute;
  z-index: 5;
  display: block;
  appearance: none;
  padding: 0;
  border: 0;
  border-radius: 10px;
  background: transparent;
  cursor: pointer;
}

.hotspot span {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.hotspot:hover {
  background: rgba(255, 0, 126, 0.1);
  box-shadow:
    0 0 20px rgba(255, 0, 126, 0.45),
    inset 0 0 0 1px rgba(255, 255, 255, 0.28);
}

.hotspot:focus-visible {
  outline: 3px solid #ff1688;
  outline-offset: 2px;
  background: rgba(255, 0, 126, 0.18);
}

