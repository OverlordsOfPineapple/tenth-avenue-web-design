/* Modal */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 24px;
  overflow-y: auto;
  background: rgba(0, 0, 0, 0.84);
  backdrop-filter: blur(12px);
}

.modal {
  position: relative;
  width: min(620px, 100%);
  padding: 42px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 24px;
  background:
    radial-gradient(
      circle at top right,
      rgba(255, 0, 126, 0.2),
      transparent 40%
    ),
    linear-gradient(145deg, #171317, #080808);
  box-shadow:
    0 0 70px rgba(255, 0, 126, 0.2),
    0 30px 80px rgba(0, 0, 0, 0.8);
}

.modal h2 {
  margin: 8px 0 20px;
  font-size: clamp(2rem, 5vw, 3.4rem);
  line-height: 0.95;
  letter-spacing: -0.04em;
  text-transform: uppercase;
}

.modal-eyebrow {
  margin: 0;
  color: #ff1688;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.modal-copy {
  color: #beb8bd;
  font-size: 1.05rem;
  line-height: 1.75;
}

.modal-close {
  position: absolute;
  top: 14px;
  right: 18px;
  width: 42px;
  height: 42px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: #ffffff;
  background: transparent;
  cursor: pointer;
  font-size: 2rem;
  line-height: 1;
}

.modal-close:hover {
  color: #ff1688;
  background: rgba(255, 255, 255, 0.06);
}

.project-form {
  display: grid;
  gap: 17px;
}

.project-form label {
  display: grid;
  gap: 8px;
  color: #ddd7dc;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.project-form input,
.project-form select,
.project-form textarea {
  width: 100%;
  padding: 14px 15px;
  border: 1px solid #343034;
  border-radius: 10px;
  outline: none;
  color: #ffffff;
  background: #0d0c0d;
  text-transform: none;
  letter-spacing: normal;
}

.project-form input:focus,
.project-form select:focus,
.project-form textarea:focus {
  border-color: #ff1688;
  box-shadow: 0 0 0 3px rgba(255, 22, 136, 0.13);
}

.project-form textarea {
  resize: vertical;
}

.pink-button {
  width: fit-content;
  min-height: 50px;
  margin-top: 8px;
  padding: 0 24px;
  border: 1px solid #ff1688;
  border-radius: 999px;
  color: #ffffff;
  background: #d90069;
  cursor: pointer;
  font-weight: 900;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  box-shadow: 0 0 22px rgba(255, 0, 126, 0.3);
}

.pink-button:hover {
  background: #ff1688;
  box-shadow: 0 0 35px rgba(255, 0, 126, 0.55);
  transform: translateY(-1px);
}

.success-message {
  padding: 22px;
  border: 1px solid rgba(255, 22, 136, 0.45);
  border-radius: 14px;
  background: rgba(255, 22, 136, 0.08);
}

.success-message strong {
  color: #ff1688;
  font-size: 1.15rem;
}

.success-message p {
  margin-bottom: 0;
  color: #d4cdd2;
  line-height: 1.6;
}

.portfolio-list {
  display: grid;
  gap: 12px;
}

.portfolio-list article {
  display: grid;
  grid-template-columns: 52px 1fr;
  gap: 15px;
  padding: 18px;
  border: 1px solid #302c30;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.025);
}

.portfolio-list article > span {
  color: #ff1688;
  font-weight: 900;
}

.portfolio-list h3 {
  margin: 0 0 7px;
  font-size: 1rem;
  text-transform: uppercase;
}

.portfolio-list p {
  margin: 0;
  color: #aaa3a8;
  line-height: 1.5;
}

@media (max-width: 700px) {
  .modal {
    padding: 34px 22px 26px;
    border-radius: 18px;
  }

  .modal-backdrop {
    padding: 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  .pink-button {
    transition: none;
  }
}

/* Allow visitors to highlight and copy page text */
body,
body * {
  -webkit-user-select: text !important;
  user-select: text !important;
}

::selection {
  background: #ff2ea6;
  color: #ffffff;
}

/* Remove the What We Do services section */
#services {
  display: none !important;
}

/* Crop the baked-in services area from the homepage image */
.website-canvas {
  position: relative !important;
  width: 100% !important;
  height: auto !important;
  min-height: 0 !important;
  aspect-ratio: 1536 / 752 !important;
  overflow: hidden !important;
}

.website-image {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: auto !important;
  max-width: none !important;
  display: block !important;
}
