:root {
  font-family: "Montserrat", Arial, sans-serif;
  color: #ffffff;
  background: #020203;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --pink: #ff2ca6;
  --pink-bright: #ff3ab2;
  --muted: #b9b9c0;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-width: 320px;
  min-height: 100%;
  background: #020203;
}

body {
  overflow-x: hidden;
}

button,
input,
textarea {
  font: inherit;
}

button {
  color: inherit;
}

button:focus-visible,
input:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--pink);
  outline-offset: 3px;
}

.page-shell {
  width: 100%;
  min-height: 100vh;
  background: #020203;
}

.hero {
  position: relative;
  isolation: isolate;
  width: 100%;
  aspect-ratio: 1536 / 752;
  min-height: 610px;
  overflow: hidden;
  background: #020203;
}

.scene-image {
  position: absolute;
  z-index: -5;
  top: 0;
  left: 0;
  width: 100%;
  height: auto;
  display: block;
  pointer-events: none;
  user-select: none;
}

/* Remove the baked-in left-side copy while keeping the exact car scene. */
.copy-mask {
  position: absolute;
  z-index: -2;
  top: 10.5%;
  left: 0;
  width: 43.5%;
  height: 73%;
  pointer-events: none;
  background:
    radial-gradient(
      circle at 90% 55%,
      rgba(40, 19, 35, 0.34),
      transparent 38%
    ),
    linear-gradient(
      90deg,
      #020203 0%,
      #020203 72%,
      rgba(2, 2, 3, 0.98) 80%,
      rgba(2, 2, 3, 0.82) 88%,
      rgba(2, 2, 3, 0.25) 97%,
      transparent 100%
    );
}

.site-header {
  position: absolute;
  z-index: 20;
  top: 0;
  left: 0;
  width: 100%;
  height: 12.55%;
  padding: 0 3.05%;
  display: grid;
  grid-template-columns: minmax(285px, 1fr) auto minmax(210px, 1fr);
  align-items: center;
  gap: 3.1vw;
  background:
    linear-gradient(
      180deg,
      rgba(2, 2, 3, 0.997) 0%,
      rgba(2, 2, 3, 0.985) 84%,
      rgba(2, 2, 3, 0.94) 100%
    );
}

.brand {
  justify-self: start;
  padding: 0;
  display: flex;
  align-items: center;
  gap: 0.8vw;
  border: 0;
  background: transparent;
  cursor: pointer;
  text-align: left;
}

.brand-mark {
  width: clamp(42px, 3.4vw, 58px);
  height: clamp(42px, 3.4vw, 58px);
  overflow: visible;
}

.brand-mark path {
  fill: none;
  stroke-linecap: square;
  stroke-linejoin: miter;
}

.brand-mark .mark-white {
  stroke: #ffffff;
  stroke-width: 3.4;
  filter: drop-shadow(0 0 3px rgba(255,255,255,.25));
}

.brand-mark .mark-pink {
  stroke: var(--pink);
  stroke-width: 3.4;
  filter: drop-shadow(0 0 4px rgba(255,44,166,.8));
}

.brand-mark .thin {
  stroke-width: 1.8;
}

.brand-copy {
  display: grid;
  line-height: 1;
  text-transform: uppercase;
}

.brand-copy strong {
  font-family: "Montserrat", Arial, sans-serif;
  font-size: clamp(18px, 1.55vw, 28px);
  font-weight: 700;
  letter-spacing: 0.025em;
  white-space: nowrap;
}

.brand-copy small {
  margin-top: 0.55vw;
  color: var(--pink);
  font-size: clamp(8px, 0.7vw, 13px);
  font-weight: 700;
  letter-spacing: 0.62em;
}

.site-nav {
  justify-self: center;
  display: flex;
  align-items: center;
  gap: clamp(25px, 2.9vw, 48px);
}

.site-nav button {
  position: relative;
  padding: 1vw 0;
  border: 0;
  background: transparent;
  color: #ffffff;
  cursor: pointer;
  font-family: "Montserrat", Arial, sans-serif;
  font-size: clamp(10px, 0.86vw, 15px);
  font-weight: 600;
  letter-spacing: 0.035em;
  text-transform: uppercase;
}

.site-nav button.active {
  color: var(--pink);
}

.site-nav button.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0.35vw;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--pink);
  box-shadow: 0 0 12px var(--pink);
  transform: translateX(-50%);
}

.header-quote {
  justify-self: end;
  width: clamp(160px, 11.8vw, 205px);
  height: clamp(42px, 4.45vw, 60px);
  border: 1px solid var(--pink);
  border-radius: 999px;
  background: rgba(10, 5, 10, 0.88);
  color: #ffffff;
  cursor: pointer;
  font-size: clamp(10px, 0.86vw, 15px);
  font-weight: 700;
  letter-spacing: 0.065em;
  text-transform: uppercase;
  box-shadow:
    0 0 8px rgba(255,44,166,.8),
    0 0 22px rgba(255,44,166,.45),
    inset 0 0 16px rgba(255,44,166,.08);
}

.hero-copy {
  position: absolute;
  z-index: 8;
  top: 16.8%;
  left: 3.7%;
  width: 33.2%;
}

.eyebrow {
  margin: 0 0 2.3vw;
  display: flex;
  align-items: center;
  gap: 0.85vw;
  color: var(--pink);
  font-size: clamp(10px, 0.82vw, 15px);
  font-weight: 600;
  letter-spacing: 0.045em;
  text-transform: uppercase;
}

.eyebrow > span {
  width: clamp(22px, 1.75vw, 31px);
  height: 2px;
  background: var(--pink);
  box-shadow: 0 0 8px rgba(255,44,166,.7);
}

h1 {
  margin: 0;
  font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
  font-size: clamp(52px, 4.12vw, 72px);
  font-weight: 800;
  line-height: 0.91;
  letter-spacing: -0.014em;
  text-transform: uppercase;
}

.headline-line {
  display: block;
  white-space: nowrap;
  margin-bottom: 0.68vw;
}

.headline-line:last-child {
  margin-bottom: 0;
}

.headline-character {
  display: inline-block;
  opacity: 0;
  transform: translateY(0.18em);
  animation: character-in 420ms cubic-bezier(.2,.8,.25,1) forwards;
  animation-delay: calc(110ms + var(--i) * 28ms);
}

.headline-pink {
  color: var(--pink-bright);
  text-shadow:
    0 0 7px rgba(255,44,166,.96),
    0 0 21px rgba(255,44,166,.68);
}

@keyframes character-in {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero-description {
  margin: 2.0vw 0 0;
  color: #d0d0d3;
  font-size: clamp(13px, 1.05vw, 19px);
  line-height: 1.55;
}

.hero-actions {
  margin-top: 2.25vw;
  display: flex;
  gap: 1.5vw;
}

.hero-button {
  height: clamp(45px, 4.0vw, 59px);
  padding: 0 1.9vw;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.72vw;
  border-radius: 999px;
  cursor: pointer;
  font-size: clamp(10px, 0.83vw, 15px);
  font-weight: 700;
  letter-spacing: 0.035em;
  text-transform: uppercase;
}

.hero-button.primary {
  min-width: clamp(165px, 11.7vw, 205px);
  border: 1px solid var(--pink);
  background: rgba(12, 5, 11, 0.86);
  color: #ffffff;
  box-shadow:
    0 0 8px rgba(255,44,166,.9),
    0 0 25px rgba(255,44,166,.48),
    inset 0 0 18px rgba(255,44,166,.08);
}

.hero-button.secondary {
  min-width: clamp(160px, 10.9vw, 190px);
  border: 1px solid rgba(255,255,255,.92);
  background: rgba(2, 2, 3, 0.72);
  color: #ffffff;
}

.play {
  font-size: 0.72em;
}

/* Cover the exact rectangle occupied by the baked-in strip. */
.feature-cover {
  position: absolute;
  z-index: 10;
  left: 8.55%;
  right: 8.55%;
  bottom: 3.75%;
  height: 12.0%;
  border-radius: 12px;
  background: #09090c;
  box-shadow: 0 0 18px rgba(0,0,0,.7);
}

.feature-strip {
  position: absolute;
  z-index: 11;
  left: 8.78%;
  right: 8.78%;
  bottom: 4.15%;
  height: 11.45%;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid rgba(255,255,255,.22);
  border-radius: 10px;
  background:
    linear-gradient(
      90deg,
      rgba(17,17,20,.94),
      rgba(12,12,15,.94)
    );
  box-shadow:
    0 18px 48px rgba(0,0,0,.48),
    inset 0 1px rgba(255,255,255,.03);
  backdrop-filter: blur(10px);
}

.feature {
  position: relative;
  padding: 0 2.1vw;
  display: flex;
  align-items: center;
  gap: 1.25vw;
}

.feature:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 21%;
  right: 0;
  width: 1px;
  height: 58%;
  background: rgba(255,255,255,.24);
}

.feature-icon {
  flex: 0 0 auto;
  width: clamp(27px, 2.35vw, 41px);
  height: clamp(28px, 2.4vw, 42px);
  display: grid;
  place-items: center;
  color: var(--pink);
  filter:
    drop-shadow(0 0 5px rgba(255,44,166,.95))
    drop-shadow(0 0 12px rgba(255,44,166,.6));
}

.feature-icon svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}

.feature-icon path,
.feature-icon rect {
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.feature:first-child .feature-icon path {
  fill: currentColor;
  stroke: none;
}

.feature-copy {
  display: grid;
  gap: 0.45vw;
}

.feature-copy strong {
  font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
  font-size: clamp(13px, 1.07vw, 19px);
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  white-space: nowrap;
}

.feature-copy small {
  color: #bdbdc3;
  font-size: clamp(10px, 0.77vw, 14px);
  line-height: 1.25;
  white-space: nowrap;
}

.menu-toggle {
  display: none;
}

.modal-backdrop {
  position: fixed;
  z-index: 200;
  inset: 0;
  padding: 24px;
  display: grid;
  place-items: center;
  background: rgba(0,0,0,.8);
  backdrop-filter: blur(14px);
}

.modal {
  position: relative;
  width: min(620px, 100%);
  max-height: calc(100vh - 48px);
  overflow-y: auto;
  padding: 48px;
  border: 1px solid rgba(255,44,166,.45);
  border-radius: 18px;
  background: #101014;
  box-shadow:
    0 30px 100px rgba(0,0,0,.75),
    0 0 42px rgba(255,44,166,.15);
}

.modal-close {
  position: absolute;
  top: 14px;
  right: 17px;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 50%;
  background: rgba(255,255,255,.04);
  cursor: pointer;
  font-size: 28px;
}

.modal-kicker {
  margin: 0 0 12px;
  color: var(--pink);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.modal h2 {
  margin: 0;
  font-family: "Barlow Condensed", sans-serif;
  font-size: clamp(42px, 6vw, 68px);
  line-height: .95;
  text-transform: uppercase;
}

.modal-copy {
  margin: 24px 0 0;
  color: #c8c8cf;
  line-height: 1.7;
}

.modal-form {
  margin-top: 26px;
  display: grid;
  gap: 17px;
}

.modal-form label {
  display: grid;
  gap: 7px;
  color: #dedee5;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.modal-form input,
.modal-form textarea {
  width: 100%;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 7px;
  background: rgba(255,255,255,.05);
  color: #ffffff;
}

.modal-form input {
  height: 48px;
  padding: 0 13px;
}

.modal-form textarea {
  padding: 13px;
  resize: vertical;
}

.modal-submit {
  min-height: 50px;
  border: 1px solid var(--pink);
  border-radius: 999px;
  background: rgba(255,44,166,.1);
  cursor: pointer;
  font-weight: 700;
  text-transform: uppercase;
}

@media (max-width: 1040px) {
  .hero {
    min-height: 720px;
    aspect-ratio: auto;
  }

  .scene-image {
    width: auto;
    height: 100%;
    left: 50%;
    transform: translateX(-50%);
  }

  .site-header {
    height: 86px;
    padding: 0 22px;
    grid-template-columns: 1fr auto;
  }

  .menu-toggle {
    display: grid;
    width: 46px;
    height: 42px;
    padding: 10px;
    align-content: center;
    gap: 7px;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 7px;
    background: rgba(255,255,255,.04);
  }

  .menu-toggle span {
    height: 2px;
    background: #ffffff;
  }

  .site-nav {
    position: absolute;
    top: 86px;
    left: 18px;
    right: 18px;
    padding: 14px;
    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 12px;
    background: rgba(5,5,7,.98);
  }

  .site-nav.open {
    display: flex;
  }

  .site-nav button {
    padding: 14px;
    text-align: left;
  }

  .header-quote {
    display: none;
  }

  .copy-mask {
    width: 70%;
  }

  .hero-copy {
    top: 145px;
    width: 55%;
  }

  .feature-strip {
    grid-template-columns: repeat(2, 1fr);
    height: 170px;
  }

  .feature-cover {
    height: 178px;
  }

  .feature:nth-child(2)::after {
    display: none;
  }
}

@media (max-width: 680px) {
  .hero {
    min-height: 980px;
  }

  .scene-image {
    height: 760px;
    left: 59%;
  }

  .copy-mask {
    top: 80px;
    width: 100%;
    height: 570px;
    background:
      linear-gradient(
        180deg,
        #020203 0%,
        rgba(2,2,3,.96) 48%,
        rgba(2,2,3,.52) 78%,
        transparent 100%
      );
  }

  .brand-copy strong {
    font-size: 17px;
  }

  .hero-copy {
    top: 132px;
    left: 22px;
    width: calc(100% - 44px);
  }

  h1 {
    font-size: clamp(48px, 14vw, 66px);
  }

  .hero-description {
    font-size: 14px;
  }

  .hero-actions {
    display: grid;
    gap: 13px;
  }

  .hero-button {
    width: 100%;
    padding: 0 18px;
  }

  .feature-cover {
    left: 14px;
    right: 14px;
    bottom: 15px;
    height: 288px;
  }

  .feature-strip {
    left: 16px;
    right: 16px;
    bottom: 17px;
    height: 284px;
    grid-template-columns: 1fr;
  }

  .feature {
    padding: 0 22px;
  }

  .feature:not(:last-child)::after {
    top: auto;
    right: 18px;
    bottom: 0;
    left: 18px;
    width: auto;
    height: 1px;
  }

  .feature:nth-child(2)::after {
    display: block;
  }

  .modal {
    padding: 42px 24px 28px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 1ms !important;
    animation-delay: 0ms !important;
    transition-duration: 1ms !important;
  }

  .headline-character {
    opacity: 1;
    transform: none;
  }
}


/* FEATURE_STRIP_OUTSIDE_HERO */
.feature-band {
  position: relative;
  z-index: 15;
  width: 100%;
  height: 122px;
  padding: 14px 0 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #020203;
}

.feature-band .feature-strip {
  position: relative;
  left: auto;
  right: auto;
  bottom: auto;
  width: 82.44%;
  height: 90px;
  flex: none;
}

/* The dark cover remains inside the hero to hide the old baked-in strip. */
.hero .feature-cover {
  display: block;
}

@media (max-width: 1040px) {
  .feature-band {
    height: 190px;
    padding: 10px 18px;
  }

  .feature-band .feature-strip {
    width: 100%;
    height: 170px;
  }
}

@media (max-width: 680px) {
  .feature-band {
    height: 304px;
    padding: 10px 16px;
  }

  .feature-band .feature-strip {
    width: 100%;
    height: 284px;
  }
}
