const features = [
  {
    title: "Fast Loading",
    detail: "Optimized for speed",
    Icon: LightningIcon,
  },
  {
    title: "Fully Responsive",
    detail: "Perfect on all devices",
    Icon: ResponsiveIcon,
  },
  {
    title: "SEO Optimized",
    detail: "Rank higher, get found",
    Icon: ShieldIcon,
  },
  {
    title: "Clean Code",
    detail: "Built for performance",
    Icon: CodeIcon,
  },
];

function CharacterLine({ children, pink = false, delay = 0 }) {
  return (
    <span
      className={pink ? "headline-line headline-pink" : "headline-line"}
      aria-label={children}
    >
      {[...children].map((character, index) => (
        <span
          className="headline-character"
          aria-hidden="true"
          key={`${character}-${index}`}
          style={{ "--i": index + delay }}
        >
          {character === " " ? "\u00a0" : character}
        </span>
      ))}
    </span>
  );
}

function Modal({ type, onClose }) {
  const titles = {
    services: "Services",
    portfolio: "Portfolio",
    about: "About Tenth Avenue",
    process: "Our Process",
    contact: "Contact",
    quote: "Get a Quote",
  };

  useEffect(() => {
    function handleEscape(event) {
      if (event.key === "Escape") onClose();
    }

    window.addEventListener("keydown", handleEscape);
    document.body.style.overflow = "hidden";

    return () => {
      window.removeEventListener("keydown", handleEscape);
      document.body.style.overflow = "";
    };
  }, [onClose]);

  return (
    <div
      className="modal-backdrop"
      onMouseDown={(event) => {
        if (event.target === event.currentTarget) onClose();
      }}
    >
      <section
        className="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
      >
        <button
          className="modal-close"
          type="button"
          aria-label="Close"
          onClick={onClose}
        >
          ×
        </button>

        <p className="modal-kicker">Tenth Avenue Web Design</p>
        <h2 id="modal-title">{titles[type]}</h2>

        {type === "quote" || type === "contact" ? (
          <form
            className="modal-form"
            onSubmit={(event) => event.preventDefault()}
          >
            <label>
              Name
              <input name="name" autoComplete="name" required />
            </label>
            <label>
              Email
              <input name="email" type="email" autoComplete="email" required />
            </label>
            <label>
              Project details
              <textarea name="details" rows="5" required />
            </label>
            <button className="modal-submit" type="submit">
              Send enquiry <span aria-hidden="true">→</span>
            </button>
          </form>
        ) : (
          <p className="modal-copy">
            This area is now a real React interface. Its detailed page content
            will be built after the homepage visual match is locked.
          </p>
        )}
      </section>
    </div>
  );
}

