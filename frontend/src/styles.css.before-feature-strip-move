  font-size: 0.72rem;
}

.button-primary {
  min-width: 180px;
  border-color: var(--pink);
  background: rgba(255, 44, 166, 0.08);
  box-shadow:
    0 0 10px rgba(255, 44, 166, 0.8),
    0 0 26px rgba(255, 44, 166, 0.4),
    inset 0 0 18px rgba(255, 44, 166, 0.08);
}

.button-secondary {
  min-width: 167px;
  border-color: rgba(255, 255, 255, 0.78);
  border-radius: 14px;
  background: rgba(7, 7, 9, 0.68);
}

/* Cover the old baked-in strip with a matching coded strip. */
.feature-strip {
  position: absolute;
  z-index: 8;
  left: 8.72%;
  right: 8.72%;
  bottom: 4.15%;
  height: 11.45%;
  min-height: 86px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid rgba(255, 255, 255, 0.17);
  border-radius: 11px;
  background:
    linear-gradient(
      90deg,
      rgba(16, 16, 19, 0.96),
      rgba(12, 12, 15, 0.94)
    );
  box-shadow:
    0 16px 40px rgba(0, 0, 0, 0.48),
    inset 0 1px rgba(255, 255, 255, 0.025);
  backdrop-filter: blur(14px);
}

.feature {
  padding: 13px clamp(18px, 2.2vw, 34px);
  gap: 18px;
}

.feature-icon {
  min-width: 38px;
  color: var(--pink);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 1.8rem;
  text-shadow:
    0 0 8px rgba(255, 44, 166, 0.95),
    0 0 20px rgba(255, 44, 166, 0.55);
}

.feature strong {
  font-size: clamp(0.69rem, 0.78vw, 0.82rem);
  letter-spacing: 0.035em;
}

.feature small {
  color: #b7b7bd;
  font-size: clamp(0.67rem, 0.72vw, 0.76rem);
}

.feature:not(:last-child)::after {
  top: 18%;
  height: 64%;
  background: rgba(255, 255, 255, 0.18);
}

/* Keep text genuinely selectable. */
.hero-content,
.feature-strip,
.site-header {
  user-select: text;
}

/* Responsive version retains real coded controls. */
@media (max-width: 1080px) {
  .site-header {
    grid-template-columns: 1fr auto auto;
  }

  .hero {
    height: auto;
    min-height: 100svh;
  }

  .hero-content {
    top: 16%;
    width: 53%;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 4.8rem);
  }

  .feature-strip {
    height: auto;
    min-height: 160px;
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 720px) {
  .site-header {
    height: var(--header-height);
    padding: 10px 18px;
    grid-template-columns: 1fr auto;
  }

  .hero {
    min-height: 100svh;
    padding-bottom: 315px;
  }

  .hero-photograph {
    background-size: auto 100%;
    background-position: 64% top;
    opacity: 0.68;
  }

  .hero::before {
    background:
      linear-gradient(
        180deg,
        #050506 0%,
        rgba(5, 5, 6, 0.94) 44%,
        rgba(5, 5, 6, 0.22) 72%,
        #050506 100%
      );
  }

  .hero-content {
    position: relative;
    top: auto;
    left: auto;
    width: auto;
    padding: calc(var(--header-height) + 48px) 22px 0;
  }

  h1 {
    font-size: clamp(2.75rem, 13vw, 4.5rem);
  }

  .feature-strip {
    left: 16px;
    right: 16px;
    bottom: 17px;
    grid-template-columns: 1fr;
  }
}


/* PINK_LIGHTNING_ICON */
.feature:first-child .feature-icon {
  color: #ff2ca6 !important;
}

.lightning-icon {
  width: 30px;
  height: 30px;
  display: block;
  fill: #ff2ca6;
  filter:
    drop-shadow(0 0 5px rgba(255, 44, 166, 1))
    drop-shadow(0 0 12px rgba(255, 44, 166, 0.65));
}
